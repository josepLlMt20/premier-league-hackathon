          "available_second",
          "to_sequence",
          "last_event_second"
        ],
        "title": "ResolvedCursor",
        "type": "object"
      },
      "ShotAttributes": {
        "additionalProperties": false,
        "properties": {
          "on_target": {
            "title": "On Target",
            "type": "boolean"
          },
          "under_pressure": {
            "default": false,
            "title": "Under Pressure",
            "type": "boolean"
          }
        },
        "required": [
          "on_target"
        ],
        "title": "ShotAttributes",
        "type": "object"
      },
      "SubstitutionAttributes": {
        "additionalProperties": false,
        "properties": {
          "replaced_player_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$",
            "title": "Replaced Player Id",
            "type": "string"
          },
          "replacement_player_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$",
            "title": "Replacement Player Id",
            "type": "string"
          }
        },
        "required": [
          "replaced_player_id",
          "replacement_player_id"
        ],
        "title": "SubstitutionAttributes",
        "type": "object"
      },
      "Team": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "players": {
            "items": {
              "$ref": "#/components/schemas/Player"
            },
            "minItems": 2,
            "title": "Players",
            "type": "array"
          },
          "team_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$",
            "title": "Team Id",
            "type": "string"
          }
        },
        "required": [
          "team_id",
          "name",
          "players"
        ],
        "title": "Team",
        "type": "object"
      },
      "TeamScore": {
        "additionalProperties": false,
        "properties": {
          "goals": {
            "minimum": 0.0,
            "title": "Goals",
            "type": "integer"
          },
          "team_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$",
            "title": "Team Id",
            "type": "string"
          }
        },
        "required": [
          "team_id",
          "goals"
        ],
        "title": "TeamScore",
        "type": "object"
      },
      "TraceStep": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "title": "Decision",
            "type": "string"
          },
          "role": {
            "enum": [
              "analyst",
              "writer",
              "reviewer",
              "system"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "decision"
        ],
        "title": "TraceStep",
        "type": "object"
      },
      "TurnoverAttributes": {
        "additionalProperties": false,
        "properties": {
          "to_team_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$",
            "title": "To Team Id",
            "type": "string"
          }
        },
        "required": [
          "to_team_id"
        ],
        "title": "TurnoverAttributes",
        "type": "object"
      }
    }
  },
