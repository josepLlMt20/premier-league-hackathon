{
  "name": "match-context-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest",
    "test:e2e": "playwright test",
    "api:types": "openapi-typescript openapi.json -o src/api/schema.d.ts --immutable",
    "api:check": "openapi-typescript openapi.json -o src/api/schema.d.ts --immutable --check",
    "format:check": "prettier --check src e2e/*.ts *.ts *.json index.html"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
