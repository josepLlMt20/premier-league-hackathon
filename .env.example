FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
FOUNDRY_MODEL=gpt-5-mini
APP_ENV=development
AGENT_MODE=factual
STORAGE_BACKEND=sqlite
CONTEXT_TIMEOUT_SECONDS=25
# Set AGENT_MODE=foundry explicitly to enable requests to the existing deployment.
# The local launcher uses Azure CLI identity; it never creates Azure resources.
